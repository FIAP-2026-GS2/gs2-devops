# Copie para scripts/.env e preencha. O .env não vai para o Git (está no .gitignore).
# Usado só pelos scripts locais de provisionamento. As pipelines usam o Variable Group.

# Região onde o Azure SQL está "Available" (resultado do 00-verificar-assinatura.sh).
AZ_LOCATION=

# Opcional: id da assinatura. Vazio = a assinatura ativa no "az account show".
AZ_SUBSCRIPTION_ID=

# Sufixo dos nomes que precisam ser únicos no mundo todo (servidor SQL, ACR e DNS do ACI).
# De 3 a 10 caracteres, só letras minúsculas e números. Ex.: gs2a7
NAME_SUFFIX=

# Administrador do servidor Azure SQL. Não pode ser admin, sa, root nem administrator.
SQL_ADMIN_USER=sampatechadmin

# Senha do administrador: 12+ caracteres, com maiúscula, minúscula, número e símbolo.
# Evite $, aspas, ponto e vírgula e espaço (quebram a connection string e o bash).
SQL_ADMIN_PASSWORD=

# Opcional: seu IP público, liberado no firewall do SQL para os SELECTs do vídeo.
# Vazio = o script descobre sozinho.
CLIENT_IP=
